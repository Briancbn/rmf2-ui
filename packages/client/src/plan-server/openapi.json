    "/v1/tasks/random": {
      "post": {
        "tags": ["tasks"],
        "summary": "Submit Random Tasks",
        "description": "Generate a random reachable goal for each robot and submit it exactly like\n``POST /tasks``. Useful for stress-testing without hand-picking waypoints.\n\n- ``robot_ids``: robots to generate a task for; defaults to all onboarded robots.\n  Supports glob wildcards against onboarded robot_ids, e.g. ``Manufacturer/*``\n  or just ``*`` for all of them.\n- ``seed``: makes the goal selection reproducible across calls.\n\nGoals are drawn, without replacement, from non-obstacle nodes present in the\nsolver's grid \u2014 MAPFCoordinator.solve() rejects a batch outright if two robots\nare given the same goal, so goals in one batch are always distinct.",
        "operationId": "submit_random_tasks_v1_tasks_random_post",
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": ["dry_run", "plan", "submit"],
              "type": "string",
              "default": "submit",
              "title": "Mode"
            }
          },
          {
            "name": "robot_ids",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Robot Ids"
            }
          },
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Seed"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSubmitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/random/nearby": {
      "post": {
        "tags": ["tasks"],
        "summary": "Submit Random Nearby Tasks",
        "description": "Like ``POST /tasks/random``, but each robot's goal is drawn from nodes within\n``steps`` grid hops of its ``start_location`` instead of anywhere reachable on\nthe map \u2014 for exercising short, mostly-independent moves rather than long,\nconflict-heavy crossings.\n\n- ``robot_ids``: robots to generate a task for; defaults to all onboarded robots.\n  Supports glob wildcards against onboarded robot_ids, e.g. ``Manufacturer/*``\n  or just ``*`` for all of them.\n- ``seed``: makes the goal selection reproducible across calls.\n\n``start_location`` only reflects where a robot was onboarded, not its live\nposition, so the neighbourhood this draws from can be stale for a robot\nthat has since moved. Goals are picked one robot at a time and excluded from\nlater robots' candidate pools, so a batch never assigns the same goal twice \u2014\nMAPFCoordinator.solve() would otherwise reject the whole batch.",
        "operationId": "submit_random_nearby_tasks_v1_tasks_random_nearby_post",
        "parameters": [
          {
            "name": "steps",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Max grid hops from each robot's start_location",
              "title": "Steps"
            },
            "description": "Max grid hops from each robot's start_location"
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": ["dry_run", "plan", "submit"],
              "type": "string",
              "default": "submit",
              "title": "Mode"
            }
          },
          {
            "name": "robot_ids",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Robot Ids"
            }
          },
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Seed"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSubmitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
