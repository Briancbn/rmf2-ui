{
  "name": "rmf2-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rmf2-dashboard": "workspace:*"
  },
  "scripts": {
    "start": "pnpm --dir apps/dashboard start",
    "build": "pnpm --dir apps/dashboard build",
    "preview": "pnpm --dir apps/dashboard preview",
    "test": "vitest",
    "lint": "eslint --max-warnings=0 --ext .js,.ts,.tsx ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
